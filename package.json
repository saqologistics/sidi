{
  "name": "sidi-travel-and-tours",
  "private": true,
  "version": "1.0.0",
  "description": "Online Travel Agency and Hajj & Umrah booking platform for Sidi Travel & Tours Ltd., Kano, Nigeria.",
  "type": "module",
  "main": "server.ts",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:client": "vite",
    "start": "tsx server.ts --prod",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"for (const p of ['dist', 'server.js', '.vercel']) require('fs').rmSync(p, { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/utils/travelLogic.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
